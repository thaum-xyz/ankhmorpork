{
  "extends": [
    "config:recommended"
  ],
  "prCreation": "immediate",
  "assignees": [
    "paulfantom"
  ],
  "reviewers": [
    "paulfantom"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/metal/group_vars/k3s.yml/"
      ],
      "matchStrings": [
        "k3s_version: (?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "k3s-io/k3s",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "golang-version:\\s(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "golang"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "kubeconform-version:\\s(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "yannh/kubeconform"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "kustomize-version:\\s(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/kustomize",
      "extractVersionTemplate": "^kustomize\\/(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "kubescape-version:\\s(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubescape/kubescape"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "yq-version:\\s(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "mikefarah/yq"
    },
    {
      "customType": "regex",
      "description": "Zensical, pinned in the docs workflow and the Makefile.",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/",
        "/^Makefile$/"
      ],
      "matchStrings": [
        "zensical-version:\\s(?<currentValue>.*?)\\n",
        "ZENSICAL_VERSION:=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "zensical"
    },
    {
      "customType": "regex",
      "description": "Container image tags quoted in the docs, so a how-to's copy-paste block tracks the cluster instead of freezing on the day it was written.",
      "managerFilePatterns": [
        "/^docs/.+\\.md$/"
      ],
      "matchStrings": [
        "image: (?<depName>[a-z0-9.-]+(?:/[a-z0-9._-]+)+):(?<currentValue>v?[0-9][A-Za-z0-9.+-]*)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "shellcheck-version:\\s(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "koalaman/shellcheck"
    }
  ],
  "packageRules": [
    {
      "addLabels": [
        "dependencies/ci",
        "dependencies/automerge"
      ],
      "groupName": "github actions",
      "matchFileNames": [
        ".github/**"
      ],
      "automerge": true
    },
    {
      "description": "Bare metal: its own group, deliberately never automerged.",
      "addLabels": [
        "dependencies/hosting"
      ],
      "groupName": "bare metal",
      "matchFileNames": [
        "metal/**"
      ]
    },
    {
      "description": "Cluster bootstrap controllers are soaked and deliberately not automerged: a bad flux2, cert-manager, or external-secrets bump takes everything else with it.",
      "addLabels": [
        "dependencies/core"
      ],
      "groupName": "core infrastructure",
      "matchFileNames": [
        "k8s/bootstrap/**",
        "k8s/platform/cluster/flux-system/**",
        "k8s/platform/security/cert-manager/**",
        "k8s/platform/security/external-secrets/**"
      ],
      "minimumReleaseAge": "10 days"
    },
    {
      "addLabels": [
        "dependencies/base",
        "dependencies/automerge"
      ],
      "groupName": "hosting infrastructure",
      "matchFileNames": [
        "k8s/platform/**",
        "!k8s/platform/cluster/flux-system/**",
        "!k8s/platform/security/cert-manager/**",
        "!k8s/platform/security/external-secrets/**"
      ],
      "minimumReleaseAge": "10 days",
      "automerge": true
    },
    {
      "addLabels": [
        "dependencies/apps",
        "dependencies/automerge"
      ],
      "groupName": "applications",
      "matchFileNames": [
        "k8s/apps/**"
      ],
      "minimumReleaseAge": "20 days",
      "automerge": true
    },
    {
      "description": "Own images (ghcr.io/thaum-xyz/*): skip the 20-day apps soak so CalVer bumps deploy fast (interim until Flux Image Automation)",
      "matchPackageNames": [
        "/^ghcr\\.io\\/thaum-xyz\\//"
      ],
      "addLabels": [
        "dependencies/apps",
        "dependencies/automerge"
      ],
      "groupName": "applications",
      "minimumReleaseAge": "0",
      "automerge": true
    },
    {
      "description": "Image tags quoted in docs: the same soak as the apps they mirror, automerged because the docs build is the only thing they can break.",
      "matchFileNames": [
        "docs/**"
      ],
      "addLabels": [
        "dependencies/docs",
        "dependencies/automerge"
      ],
      "groupName": "documentation examples",
      "minimumReleaseAge": "20 days",
      "automerge": true
    },
    {
      "description": "Zensical is alpha (0.0.x) and can change rendering between patch releases. The docs build gates it, but a green build does not prove the site still looks right, so it lands as its own PR and is never automerged.",
      "matchDepNames": [
        "zensical"
      ],
      "groupName": "zensical",
      "addLabels": [
        "dependencies/ci"
      ],
      "automerge": false,
      "minimumReleaseAge": "3 days"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "k8s/**"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/(?:^|/)[^/]*release\\.ya?ml$/",
      "/(?:^|/)[^/]*repository\\.ya?ml$/"
    ]
  }
}
